# SUDHARSARTHI - Environment Configuration Template
# Copy this file to .env in backend/ or export these environment variables.
# With defaults, the application runs out-of-the-box (local SQLite + rules-engine urgency + outbox alerts).

# --- Security & Authentication
SESSION_SECRET=sudharsarthi-change-this-secret-key-in-production-2026
COOKIE_SECURE=0
OFFICER_API_KEY=sudharsarthi-officer-secret-key-2026
ALLOW_DEMO_RESET=1

# --- CORS & Origins
# For cross-origin frontend (e.g. Vercel), set to your domain or comma-separated domains:
# CORS_ORIGIN=https://sudharsarthi.vercel.app,http://localhost:3000
CORS_ORIGIN=*

# --- Service Area & Geographical Boundaries (Ghaziabad & Duhai NCR Region)
SERVICE_AREA_NAME=Ghaziabad & Duhai Region
SERVICE_CENTER_LAT=28.6950
SERVICE_CENTER_LNG=77.4450
SERVICE_BOUNDS_S=28.5800
SERVICE_BOUNDS_W=77.3300
SERVICE_BOUNDS_N=28.8200
SERVICE_BOUNDS_E=77.5600

# --- Database & Uploads
SUDHARSARTHI_DB=sudharsarthi.db
UPLOAD_DIR=uploads
SEED_DEMO=1

# --- AI Urgency Vision Audit (Optional: Claude Vision model via Anthropic API)
# If omitted, SUDHARSARTHI seamlessly operates in deterministic rules-engine mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Email Notifications for Ward Officers
# If omitted, notification emails are written to backend/outbox/<id>.txt for presentation/inspection.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DEFAULT_OFFICER_EMAIL=awasthishailendra59@gmail.com
ALERT_RECIPIENT_EMAIL=awasthishailendra59@gmail.com

# --- Server Ports & Static Frontend Serving
PORT=5000
HOST=0.0.0.0
# FRONTEND_DIR=../frontend
